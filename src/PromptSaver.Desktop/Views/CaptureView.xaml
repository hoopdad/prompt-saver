<UserControl x:Class="PromptSaver.Desktop.Views.CaptureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             MinWidth="300"
             MinHeight="240">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource PageHeadingStyle}"
                           Text="Capture a prompt"
                           automation:AutomationProperties.AutomationId="CaptureHeading" />
                <TextBlock Margin="4,-7,4,0" Style="{StaticResource MutedTextStyle}"
                           Text="Your draft is backed up locally while you work." />
            </StackPanel>
            <WrapPanel x:Name="CaptureActions"
                       Grid.Column="1"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       automation:AutomationProperties.AutomationId="CaptureActions">
                <Button Content="New"
                        Command="{Binding NewPromptCommand}"
                        automation:AutomationProperties.AutomationId="NewPromptAction" />
                <Button Content="Copy"
                        Command="{Binding CopyCommand}"
                        automation:AutomationProperties.AutomationId="CopyPromptButton"
                        automation:AutomationProperties.Name="Copy current prompt text" />
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Content="{Binding PrimaryActionText}"
                        Command="{Binding SaveCommand}"
                        automation:AutomationProperties.AutomationId="SavePromptButton"
                        automation:AutomationProperties.Name="Save prompt" />
            </WrapPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12">
            <TextBox x:Name="PromptEditor"
                 BorderThickness="0"
                 Grid.Row="1"
                 MinHeight="150"
                 AcceptsReturn="True"
                 AcceptsTab="False"
                 SpellCheck.IsEnabled="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                 automation:AutomationProperties.AutomationId="PromptEditor"
                 automation:AutomationProperties.Name="Prompt"
                 automation:AutomationProperties.HelpText="Enter or paste the prompt to save. Ctrl+Enter saves and Ctrl+Shift+C copies." />
        </Border>

        <DockPanel Grid.Row="2" MinHeight="34" Margin="8,4">
            <TextBlock DockPanel.Dock="Right"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Text="{Binding SizeText}"
                       Visibility="{Binding ShowSize, Converter={StaticResource BooleanToVisibilityConverter}}"
                       automation:AutomationProperties.Name="Prompt size" />
            <TextBlock VerticalAlignment="Center"
                       Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       automation:AutomationProperties.AutomationId="CaptureStatus"
                       automation:AutomationProperties.LiveSetting="Polite" />
        </DockPanel>

        <Border Grid.Row="3"
                Margin="3,2,3,6"
                Padding="8"
                Background="{DynamicResource SurfaceMutedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                CornerRadius="8"
                BorderThickness="1"
                Visibility="{Binding HasIntentFeedback, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           Text="Intent" />
                <TextBlock Text="{Binding IntentFeedback}" TextWrapping="Wrap" />
                <Button HorizontalAlignment="Left"
                        Content="Review intent"
                        Command="{Binding ReviewIntentCommand}"
                        automation:AutomationProperties.AutomationId="ReviewIntentButton"
                        automation:AutomationProperties.HelpText="Review a provisional, low-confidence, or Unsorted intent assignment." />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal">
                <Button Content="{Binding MetadataActionText}"
                        Foreground="{DynamicResource TextBrush}"
                        Command="{Binding ReviewMetadataCommand}"
                        automation:AutomationProperties.AutomationId="CaptureMetadataButton"
                        automation:AutomationProperties.Name="Edit prompt metadata"
                        automation:AutomationProperties.HelpText="Saves the prompt first when needed, then opens its metadata editor." />
                <Button Content="Try draft backup again"
                        Command="{Binding RetryBackupCommand}"
                        Visibility="{Binding CanRetryDraftBackup, Converter={StaticResource BooleanToVisibilityConverter}}"
                        automation:AutomationProperties.AutomationId="RetryDraftButton" />
        </StackPanel>
    </Grid>
</UserControl>
