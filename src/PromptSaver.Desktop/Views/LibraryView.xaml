<UserControl x:Class="PromptSaver.Desktop.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource PageHeadingStyle}"
                       Text="Prompt Library"
                       automation:AutomationProperties.AutomationId="LibraryHeading" />
            <Button Grid.Column="1"
                    VerticalAlignment="Top"
                    Content="View all"
                    Command="{Binding ViewAllCommand}"
                    automation:AutomationProperties.AutomationId="ViewAllPromptsButton" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Margin="3,0" Text="Search prompts" />
                <TextBox x:Name="LibrarySearch"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         automation:AutomationProperties.AutomationId="LibrarySearch"
                         automation:AutomationProperties.Name="Search prompts"
                         automation:AutomationProperties.HelpText="Search prompt text, title, intent, skills, and entities." />
            </StackPanel>
            <Button Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Content="Search"
                    Command="{Binding SearchCommand}"
                    IsDefault="True"
                    automation:AutomationProperties.AutomationId="SearchButton" />
        </Grid>

        <WrapPanel x:Name="LibraryFilters"
                   Grid.Row="2"
                   Margin="0,4"
                   automation:AutomationProperties.AutomationId="LibraryFilters">
            <CheckBox Content="Needs review"
                      IsChecked="{Binding NeedsReviewOnly}"
                      automation:AutomationProperties.Name="Show prompts needing intent review" />
            <Button Content="Clear search or filters"
                    Command="{Binding ClearSearchCommand}"
                    automation:AutomationProperties.AutomationId="ClearSearchButton" />
        </WrapPanel>

        <DataGrid x:Name="LibraryResults"
                  Grid.Row="3"
                  Margin="4"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  IsReadOnly="True"
                  ItemsSource="{Binding Results}"
                  SelectedItem="{Binding SelectedPrompt}"
                  Sorting="OnSorting"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  RowHeight="42"
                  AlternationCount="2"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  automation:AutomationProperties.AutomationId="LibraryResults"
                  automation:AutomationProperties.Name="Prompt search results">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Intent"
                                    SortMemberPath="Intent"
                                    Width="1.4*"
                                    Binding="{Binding Intent.CanonicalName}" />
                <DataGridTextColumn Header="Title"
                                    SortMemberPath="Title"
                                    Width="1.4*"
                                    Binding="{Binding Title}" />
                <DataGridTemplateColumn Header="Prompt"
                                        SortMemberPath="Prompt"
                                        Width="2.5*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding BodyPreview}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Modified"
                                    SortMemberPath="Modified"
                                    Width="Auto"
                                    Binding="{Binding UpdatedAtUtc, StringFormat={}{0:g}}" />
                <DataGridTextColumn Header="Copies"
                                    SortMemberPath="Copies"
                                    Width="Auto"
                                    Binding="{Binding CopyCount, StringFormat=N0}" />
                <DataGridTemplateColumn Header="Actions"
                                        CanUserSort="False"
                                        Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Open"
                                        Command="{Binding DataContext.OpenPromptCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        automation:AutomationProperties.Name="Open prompt"
                                        automation:AutomationProperties.AutomationId="OpenPromptButton" />
                                <Button Content="Copy"
                                        Command="{Binding DataContext.CopyPromptCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        automation:AutomationProperties.Name="Copy prompt"
                                        automation:AutomationProperties.AutomationId="CopyLibraryPromptButton" />
                                <Button Content="More"
                                        Command="{Binding DataContext.MoreOptionsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        automation:AutomationProperties.Name="More options for prompt"
                                        automation:AutomationProperties.AutomationId="PromptMoreButton" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="4"
                           VerticalAlignment="Center"
                           Text="Rows per page" />
                <TextBox Grid.Column="1"
                         Width="54"
                         Text="{Binding PageSizeText, UpdateSourceTrigger=PropertyChanged}"
                         automation:AutomationProperties.AutomationId="LibraryPageSize"
                         automation:AutomationProperties.Name="Rows per page" />
                <Button Grid.Column="2"
                        HorizontalAlignment="Left"
                        Content="Apply"
                        Command="{Binding ApplyPageSizeCommand}"
                        automation:AutomationProperties.AutomationId="ApplyLibraryPageSizeButton" />
                <Button Grid.Column="3"
                        Content="Previous"
                        Command="{Binding PreviousPageCommand}"
                        automation:AutomationProperties.AutomationId="PreviousLibraryPageButton" />
                <TextBlock Grid.Column="4"
                           Margin="10,4"
                           VerticalAlignment="Center"
                           Text="{Binding PageStatus}"
                           automation:AutomationProperties.AutomationId="LibraryPageStatus" />
                <Button Grid.Column="5"
                        Content="Next"
                        Command="{Binding NextPageCommand}"
                        automation:AutomationProperties.AutomationId="NextLibraryPageButton" />
            </Grid>
            <Border Margin="3"
                    Padding="10"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Focusable="True"
                    Visibility="{Binding HasMoreOptionsPrompt, Converter={StaticResource BooleanToVisibilityConverter}}"
                    automation:AutomationProperties.AutomationId="LibraryMoreOptions">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold"
                               Text="{Binding MoreOptionsPrompt.Title, StringFormat=More options for {0}}" />
                    <WrapPanel>
                        <Button Content="Review intent"
                                Command="{Binding ReviewIntentCommand}"
                                automation:AutomationProperties.AutomationId="LibraryReviewIntentButton" />
                        <Button Content="Review metadata"
                                Command="{Binding ReviewMetadataCommand}"
                                automation:AutomationProperties.AutomationId="LibraryReviewMetadataButton" />
                        <Button Content="Duplicate"
                                Command="{Binding DuplicatePromptCommand}"
                                automation:AutomationProperties.AutomationId="LibraryDuplicateButton" />
                        <Button Content="Permanently delete..."
                                Command="{Binding RequestPermanentDeleteCommand}"
                                automation:AutomationProperties.AutomationId="LibraryRequestDeleteButton" />
                    </WrapPanel>
                    <Border Margin="0,6,0,0"
                            Padding="8"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Visibility="{Binding DeleteConfirmationOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                            automation:AutomationProperties.AutomationId="LibraryDeleteConfirmation">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Permanently delete this prompt?" />
                            <WrapPanel HorizontalAlignment="Right">
                                <Button Content="Cancel"
                                        Command="{Binding CancelPermanentDeleteCommand}"
                                        automation:AutomationProperties.AutomationId="LibraryCancelDeleteButton" />
                                <Button Content="Delete prompt"
                                        Command="{Binding ConfirmPermanentDeleteCommand}"
                                        automation:AutomationProperties.AutomationId="LibraryConfirmDeleteButton" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            <TextBlock
                   MinHeight="32"
                   Margin="3,6"
                   VerticalAlignment="Center"
                   Text="{Binding StatusMessage}"
                   automation:AutomationProperties.AutomationId="LibraryStatus"
                   automation:AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </Grid>
</UserControl>
