<UserControl x:Class="PromptSaver.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource PageHeadingStyle}"
                           Text="Settings"
                           automation:AutomationProperties.AutomationId="SettingsHeading" />
                <TextBlock Margin="4,-7,4,12" Style="{StaticResource MutedTextStyle}"
                           Text="Configure optional AI metadata, recovery, and accessibility." />
            </StackPanel>
            <Button Grid.Column="1"
                    VerticalAlignment="Top"
                    Content="Close settings"
                    Command="{Binding DataContext.CloseSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    automation:AutomationProperties.AutomationId="CloseSettingsButton" />
        </Grid>

        <TabControl x:Name="SettingsCategories"
                    Grid.Row="1"
                    TabStripPlacement="Top"
                    automation:AutomationProperties.AutomationId="SettingsCategories"
                    automation:AutomationProperties.Name="Settings categories">
            <TabItem Header="General">
                <StackPanel Margin="12">
                    <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Appearance and behavior" />
                    <TextBlock Text="Use the light/dark toggle in the top menu to switch appearance at any time."
                               TextWrapping="Wrap" />
                    <CheckBox Content="Check spelling in prompt editors"
                              IsChecked="True"
                              automation:AutomationProperties.AutomationId="GeneralSpellCheck" />
                    <TextBlock Margin="3,10"
                               Text="System colors and standard controls are used so Windows contrast themes remain authoritative."
                               TextWrapping="Wrap" />
                </StackPanel>
            </TabItem>

            <TabItem Header="AI metadata">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="AI metadata (optional)" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    VerticalAlignment="Center"
                                    Content="Save"
                                    Command="{Binding SaveProviderCommand}"
                                    automation:AutomationProperties.AutomationId="SaveProviderButton" />
                        </Grid>
                        <TextBlock Text="Local capture and search never leave this device. When enabled, at most the first 8192 UTF-8 bytes of a prompt are sent to the configured server."
                                   TextWrapping="Wrap" />
                        <CheckBox Content="Enable AI metadata"
                                  IsChecked="{Binding ProviderEnabled}"
                                  automation:AutomationProperties.AutomationId="EnableProviderCheckBox" />
                        <TextBlock Text="Server URL" />
                        <TextBox Text="{Binding ProviderEndpoint, UpdateSourceTrigger=PropertyChanged}"
                                 automation:AutomationProperties.AutomationId="ProviderEndpoint"
                                 automation:AutomationProperties.Name="Provider server URL" />
                        <TextBlock Text="Model or deployment" />
                        <TextBox Text="{Binding ProviderModel, UpdateSourceTrigger=PropertyChanged}"
                                 automation:AutomationProperties.AutomationId="ProviderModel"
                                 automation:AutomationProperties.Name="Provider model or deployment" />
                        <TextBlock Text="API key" />
                        <PasswordBox x:Name="ProviderApiKey"
                                     PasswordChanged="OnProviderApiKeyChanged"
                                     automation:AutomationProperties.AutomationId="ProviderApiKey"
                                     automation:AutomationProperties.Name="Provider API key"
                                     automation:AutomationProperties.HelpText="Stored only in Windows Credential Manager. Leave blank to keep the current key." />
                        <CheckBox Content="Remove saved API key"
                                  IsChecked="{Binding RemoveProviderApiKey}"
                                  IsEnabled="{Binding CredentialConfigured}"
                                  automation:AutomationProperties.AutomationId="RemoveProviderApiKey" />
                        <CheckBox Content="I understand that remote plain HTTP is not encrypted"
                                  IsChecked="{Binding RemoteHttpAcknowledged}" />
                        <WrapPanel x:Name="SettingsActions"
                                   automation:AutomationProperties.AutomationId="SettingsActions">
                            <Button Content="Detect local Ollama"
                                    Command="{Binding DiscoverOllamaCommand}"
                                    automation:AutomationProperties.AutomationId="DiscoverOllamaButton" />
                            <Button Content="Test connection"
                                    Command="{Binding TestProviderCommand}"
                                    automation:AutomationProperties.AutomationId="TestProviderButton" />
                            <Button Content="Cancel test"
                                    Command="{Binding CancelProviderTestCommand}"
                                    automation:AutomationProperties.AutomationId="CancelProviderTestButton" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Data and recovery">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Backup and recovery" />
                        <Button HorizontalAlignment="Left"
                                Content="Back up now"
                                Command="{Binding BackupCommand}"
                                automation:AutomationProperties.AutomationId="BackupNowButton" />
                        <TextBlock Margin="3,10,3,0" Text="Backup file to restore" />
                        <TextBox Text="{Binding BackupPath}"
                                 automation:AutomationProperties.AutomationId="RestoreBackupPath"
                                 automation:AutomationProperties.Name="Backup file path" />
                        <Button HorizontalAlignment="Left"
                                Content="Restore backup..."
                                Command="{Binding RequestRestoreCommand}"
                                automation:AutomationProperties.AutomationId="RestoreBackupButton" />
                        <Border Margin="3"
                                Padding="10"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                Visibility="{Binding RestoreConfirmationOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                                automation:AutomationProperties.AutomationId="RestoreConfirmation">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Restore this backup?" />
                                <TextBlock Text="Current local data will be replaced by the selected backup. Close other Prompt Saver windows first."
                                           TextWrapping="Wrap" />
                                <WrapPanel HorizontalAlignment="Right">
                                    <Button Content="Cancel"
                                            IsDefault="True"
                                            Command="{Binding CancelRestoreCommand}" />
                                    <Button Content="Restore backup"
                                            Command="{Binding RestoreCommand}"
                                            automation:AutomationProperties.AutomationId="ConfirmRestoreButton" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Button HorizontalAlignment="Left"
                                Content="Rebuild search index"
                                Command="{Binding RebuildSearchCommand}"
                                automation:AutomationProperties.AutomationId="RebuildSearchButton" />
                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Diagnostics" />
                        <TextBlock Text="{Binding DiagnosticsText}" TextWrapping="Wrap" />
                        <Button HorizontalAlignment="Left"
                                Content="Refresh diagnostics"
                                Command="{Binding RefreshDiagnosticsCommand}"
                                automation:AutomationProperties.AutomationId="RefreshDiagnosticsButton" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Intents">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Intent management" />
                        <TextBlock Text="Merge duplicate intents to reclassify every source prompt into the target intent. Prompt text is never deleted."
                                   TextWrapping="Wrap" />
                        <Button HorizontalAlignment="Left"
                                Content="Refresh intents"
                                Command="{Binding RefreshIntentsCommand}"
                                automation:AutomationProperties.AutomationId="RefreshIntentsButton" />
                        <TextBlock Margin="3,8,3,0" Text="Source intent" />
                        <ComboBox ItemsSource="{Binding Intents}"
                                  SelectedItem="{Binding SourceIntent}"
                                  DisplayMemberPath="CanonicalName"
                                  automation:AutomationProperties.AutomationId="SourceIntentPicker" />
                        <TextBlock Text="{Binding SourceIntent.PromptCount, StringFormat=Prompts to reclassify: {0}}" />
                        <TextBlock Margin="3,8,3,0" Text="Target intent" />
                        <ComboBox ItemsSource="{Binding Intents}"
                                  SelectedItem="{Binding TargetIntent}"
                                  DisplayMemberPath="CanonicalName"
                                  automation:AutomationProperties.AutomationId="TargetIntentPicker" />
                        <Button HorizontalAlignment="Left"
                                Content="Review merge..."
                                Command="{Binding RequestMergeCommand}"
                                automation:AutomationProperties.AutomationId="RequestIntentMergeButton" />
                        <Border Margin="3,8,3,0"
                                Padding="10"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                Visibility="{Binding MergeConfirmationOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                                automation:AutomationProperties.AutomationId="IntentMergeConfirmation">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Merge these intents?" />
                                <TextBlock Text="{Binding MergeConfirmationText}" TextWrapping="Wrap" />
                                <WrapPanel HorizontalAlignment="Right">
                                    <Button Content="Cancel"
                                            IsDefault="True"
                                            Command="{Binding CancelMergeCommand}" />
                                    <Button Content="Merge and reclassify"
                                            Command="{Binding MergeIntentsCommand}"
                                            automation:AutomationProperties.AutomationId="ConfirmIntentMergeButton" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Keyboard and accessibility">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Keyboard shortcuts" />
                        <TextBlock Text="Ctrl+N  New prompt&#x0a;Ctrl+Enter  Save prompt or changes&#x0a;Ctrl+Shift+Enter  Save and copy&#x0a;Ctrl+Shift+C  Copy current prompt&#x0a;Ctrl+F  Search Library&#x0a;Ctrl+,  Settings&#x0a;F6 / Shift+F6  Cycle page regions&#x0a;Alt+Left  Back"
                                   TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Accessibility" />
                        <TextBlock Text="Status announcements do not take focus. Standard Windows controls, colors, text scaling, keyboard focus, and contrast themes are respected."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="SettingsStatus"
                   Grid.Row="2"
                   MinHeight="34"
                   Margin="3,6"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap"
                   automation:AutomationProperties.AutomationId="SettingsStatus"
                   automation:AutomationProperties.LiveSetting="Polite" />
    </Grid>
</UserControl>
