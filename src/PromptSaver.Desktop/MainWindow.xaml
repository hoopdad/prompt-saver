<Window x:Class="PromptSaver.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Prompt Saver"
        Icon="pack://application:,,,/Resources/AppIcon.ico"
        Width="1000"
        Height="720"
        MinWidth="480"
        MinHeight="360"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewMouseWheel="OnPreviewMouseWheel"
        SizeChanged="OnWindowSizeChanged"
        automation:AutomationProperties.Name="Prompt Saver">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding SearchLibraryCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding SettingsCommand}" />
    </Window.InputBindings>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="14,7"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="TopNavigation"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal"
                            automation:AutomationProperties.AutomationId="Navigation">
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                        Content="New prompt"
                        Command="{Binding NewCommand}"
                        automation:AutomationProperties.AutomationId="NewNavigationButton" />
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                        Content="Library"
                        Command="{Binding LibraryCommand}"
                        automation:AutomationProperties.AutomationId="LibraryNavigationButton" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Content="A−"
                            Command="{Binding ZoomOutCommand}"
                            automation:AutomationProperties.AutomationId="ZoomOutButton"
                            automation:AutomationProperties.Name="Decrease font size" />
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Content="{Binding ZoomText}"
                            Command="{Binding ResetZoomCommand}"
                            automation:AutomationProperties.AutomationId="ResetZoomButton"
                            automation:AutomationProperties.Name="Reset font size to 100 percent" />
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Content="A+"
                            Command="{Binding ZoomInCommand}"
                            automation:AutomationProperties.AutomationId="ZoomInButton"
                            automation:AutomationProperties.Name="Increase font size" />
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Content="{Binding ThemeToggleText}"
                            Command="{Binding ToggleThemeCommand}"
                            automation:AutomationProperties.AutomationId="ThemeToggleButton" />
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Content="Settings"
                            Command="{Binding SettingsCommand}"
                            automation:AutomationProperties.AutomationId="SettingsNavigationButton" />
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl Grid.Row="1"
                        Content="{Binding CurrentPage}"
                        Focusable="False"
                        automation:AutomationProperties.AutomationId="PageContent" />

        <Border Grid.Row="2"
                MinHeight="30"
                Padding="14,5"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       automation:AutomationProperties.AutomationId="ApplicationStatus"
                       automation:AutomationProperties.LiveSetting="Polite" />
        </Border>
    </Grid>
</Window>
