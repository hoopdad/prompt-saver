<Window x:Class="PromptSaver.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Prompt Saver"
        Width="1000"
        Height="720"
        MinWidth="480"
        MinHeight="360"
        PreviewKeyDown="OnPreviewKeyDown"
        SizeChanged="OnWindowSizeChanged"
        automation:AutomationProperties.Name="Prompt Saver">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding SearchLibraryCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding SettingsCommand}" />
    </Window.InputBindings>

    <Grid Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="CompactHeader"
                Grid.Row="0"
                Padding="6"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                BorderThickness="0,0,0,1"
                Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Left"
                        Content="New"
                        Command="{Binding NewCommand}"
                        automation:AutomationProperties.AutomationId="CompactNewButton" />
                <Button DockPanel.Dock="Left"
                        Content="Library"
                        Command="{Binding LibraryCommand}"
                        automation:AutomationProperties.AutomationId="CompactLibraryButton" />
                <Menu DockPanel.Dock="Right"
                      HorizontalAlignment="Right"
                      Background="Transparent"
                      automation:AutomationProperties.AutomationId="MoreMenu">
                    <MenuItem Header="More">
                        <MenuItem Header="Settings"
                                  InputGestureText="Ctrl+,"
                                  Command="{Binding SettingsCommand}" />
                        <MenuItem Header="Keyboard shortcuts"
                                  Command="{Binding SettingsCommand}" />
                    </MenuItem>
                </Menu>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavigationColumn" Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="NavigationRail"
                    Grid.Column="0"
                    Padding="8"
                    Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                    BorderThickness="0,0,1,0"
                    automation:AutomationProperties.AutomationId="Navigation">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom"
                            HorizontalContentAlignment="Left"
                            Content="Settings"
                            Command="{Binding SettingsCommand}"
                            automation:AutomationProperties.AutomationId="SettingsNavigationButton" />
                    <StackPanel>
                        <TextBlock Margin="8,10,8,18"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Text="Prompt Saver" />
                        <Button HorizontalContentAlignment="Left"
                                Content="New prompt"
                                Command="{Binding NewCommand}"
                                automation:AutomationProperties.AutomationId="NewNavigationButton" />
                        <Button HorizontalContentAlignment="Left"
                                Content="Library"
                                Command="{Binding LibraryCommand}"
                                automation:AutomationProperties.AutomationId="LibraryNavigationButton" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ContentControl Grid.Column="1"
                            Content="{Binding CurrentPage}"
                            Focusable="False"
                            automation:AutomationProperties.AutomationId="PageContent" />
        </Grid>
    </Grid>
</Window>
